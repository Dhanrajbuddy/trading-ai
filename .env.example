# Server
PORT=3000

# ── Zerodha Kite API (optional — falls back to mock data when not set) ─────────
ZERODHA_API_KEY=your_zerodha_api_key
ZERODHA_API_SECRET=your_zerodha_api_secret
ZERODHA_ACCESS_TOKEN=your_zerodha_access_token
ORDER_PRODUCT=MIS

# ── Telegram Bot (optional — alerts sent when both are set) ───────────────────
TELEGRAM_TOKEN=your_telegram_bot_token
CHAT_ID=your_telegram_chat_id

# ── Risk Management ─────────────────────────────────────────────────────────────
CAPITAL=100000
RISK_PERCENT=1

# ── OpenAI (optional — mock confidence used when not set) ─────────────────────
OPENAI_API_KEY=your_openai_api_key

# ── Auto Trading (set to true to enable automatic order execution) ──────────────
AUTO_TRADING=false
